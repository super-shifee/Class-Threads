# Required: set a private password of at least 6 characters before starting the app.
ADMIN_PASSWORD=

# Optional locally; Render generates a persistent secret in its deployment configuration.
# Set a random value of at least 32 characters if you want to configure it locally.
SESSION_SECRET=

# Optional. Without DB_PATH, the app uses students.db beside server.js.
# On Render, set DB_PATH=/var/data/students.db.
# DB_PATH=

# Use HTTPS when NODE_ENV=production so secure session cookies work.
# NODE_ENV=development
